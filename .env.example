# Copy to .env.local (git-ignored) for local dev; set the same names in Vercel for deploys.
# Never commit real values. Never paste the service role key in chat or client code.

# Supabase project (Settings > API). URL + anon key are public by design (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the join server action to call join_queue (service_role-only function).
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (bot check on the join form).
# Dev/staging can use Cloudflare's documented always-pass test keys:
#   site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Cron calls /api/cron/whatsapp with "Authorization: Bearer <CRON_SECRET>". Long random value.
CRON_SECRET=

# Meta WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp). Leave empty to disable
# alerts: the worker then does nothing and old alerts expire unsent after 30 minutes.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar
# App secret (App settings > Basic) for webhook signatures; verify token is any random string you
# also type into Meta's webhook setup.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Public site address used inside printed QR codes (set once the real domain exists, so posters
# never point at a preview URL). Without it, the current request's host is used.
NEXT_PUBLIC_SITE_URL=
